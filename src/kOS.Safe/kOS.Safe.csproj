<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <PropertyGroup>
    <KSPBT_ReferenceUnityAssemblies>false</KSPBT_ReferenceUnityAssemblies>
    <KSPBT_ReferenceGameAssemblies>false</KSPBT_ReferenceGameAssemblies>
    <KSPBT_GenerateAssemblyAttribute>false</KSPBT_GenerateAssemblyAttribute>
    <KSPBT_GenerateDependencyAttributes>false</KSPBT_GenerateDependencyAttributes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Compilation\CompiledObject-doc.md" />
    <None Include="Compilation\KS\kRISC.tpg" />
    <Compile Remove="$(PkgKSPBuildTools)/build/include/Log.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(KSPBT_ModRoot)\$(KSPBT_ModPluginFolder)\ICSharpCode.SharpZipLib.dll" Condition="'$(KOSHeadless)' != 'true'">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="KSPBuildTools" Version="1.1.1" GeneratePathProperty="True" Condition="'$(KOSHeadless)' != 'true'" />
  </ItemGroup>
  <!-- Headless tests use standard net48 references, never game/Unity assemblies or packaging targets. -->
  <ItemGroup Condition="'$(KOSHeadless)' == 'true'">
    <Reference Include="ICSharpCode.SharpZipLib">
      <HintPath>$(MSBuildThisFileDirectory)../../Resources/GameData/kOS/Plugins/ICSharpCode.SharpZipLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
