<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Company></Company>
    <KSPBT_ModRoot>$(MSBuildThisFileDirectory)\Resources\GameData\kOS</KSPBT_ModRoot>
    <KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>
    <!-- Exact upstream release and actual fork point (same tree except CHANGELOG.md).
         These provenance properties are not the fork's own version. -->
    <KOSIM_UpstreamVersion>1.6.0.1</KOSIM_UpstreamVersion>
    <KOSIM_UpstreamCommit>8f281a459b6ea0ba917c91bbbc117e68bb948199</KOSIM_UpstreamCommit>
    <!-- First three fields follow upstream; fourth is the continuous kOSIM build counter,
         NOT upstream's fourth field. Drives assembly/file versions, kerboscript VERSION,
         generated kOS.version and KSPAssembly("kOS", 1, 6, 0). -->
    <KSPBT_ModVersion>1.6.0.104</KSPBT_ModVersion>
    <Version>$(KSPBT_ModVersion)</Version>
  </PropertyGroup>
</Project>